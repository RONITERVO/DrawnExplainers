node_modules/

# Transient: frames written by `build.mjs --preview` / `--at=`
preview/

# Derived audio. `node lib/build.mjs <ep> --audio` rebuilds both in seconds
# from assets/syncvoice/ + music.wav, so there is no reason to version ~110MB
# of WAV that changes whenever a timing does.
narration.wav
mixed.wav

# Derived video. renderFrame is pure in (t, frameIndex) and music.wav is
# committed, so `node lib/build.mjs <ep>` reproduces the exact film in ~40s.
out.mp4

# NOT ignored, deliberately:
#   music.wav          Lyria is generative with no seed - regenerating gives a
#                      different bed, so the committed file IS the master.
#   assets/syncvoice/  narration costs API calls; content-addressed, so keeping
#                      it is what makes regeneration incremental.
#   timing.json        the Whisper alignment and the QA record.

# SyncVoice checkpoint: transient by its own docs, rewritten every run.
**/.syncvoice/generation-state.json

# Defensive: OAuth material never belongs in the repo. It lives in
# D:/Projects/tempTestKeys/ alongside the other keys.
*client_secret*
*oauth*client*.json
youtube-token.json

# Clip exports from the talking-face tooling. Derived from out.mp4, ~290MB,
# and their filenames exceed the Windows path limit git can index.
out-clips*/
